# Copy this file to .env.docker on the LRZ VM and fill in the values.

# Frontend storage. For real data collection, use "firebase" or "supabase";
# "localStorage" only stores data in each participant's browser.
VITE_STORAGE_ENGINE=supabase

# Firebase frontend settings. These are build-time values for the study image.
# Keep this as a single line in .env.docker.
VITE_FIREBASE_CONFIG='{ apiKey: "your-firebase-api-key", authDomain: "your-project.firebaseapp.com", projectId: "your-project-id", storageBucket: "your-project.firebasestorage.app", messagingSenderId: "your-sender-id", appId: "your-app-id" }'
VITE_RECAPTCHAV3TOKEN=your-recaptcha-v3-site-key

# Public Supabase values embedded in the frontend build.
VITE_SUPABASE_URL=https://your-supabase-domain.example
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only Supabase access used for random codes, longitudinal state, and event tracking.
# Never expose the service-role key in VITE_* variables.
SUPABASE_URL=https://your-supabase-domain.example
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Public URL of your deployed study, used by the API for CORS and optional OpenRouter headers.
STUDY_HTTP_PORT=80
# Use https once the CIT/ITO certificate is installed with docker-compose.https.yml.
STUDY_HTTPS_PORT=443
STUDY_PUBLIC_URL=https://iivm6.cit.tum.de

# Put your LLM token here. Do not put it into HTML files.
# The proxy in services/haic_api forwards LLM requests to OpenRouter server-side.
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here

# Optional: change the LLM model.
OPENROUTER_MODEL=anthropic/claude-opus-4.7-fast

# Paste each part's server-side External Credit Granting URL from SONA here.
# Replace SONA's participant placeholder with {survey_code}; the API substitutes it securely.
SONA_PART_1_COMPLETION_URL=https://your-school.sona-systems.com/services/SonaAPI.svc/WebstudyCredit?...&survey_code={survey_code}
SONA_PART_2_COMPLETION_URL=https://your-school.sona-systems.com/services/SonaAPI.svc/WebstudyCredit?...&survey_code={survey_code}
SONA_PART_3_COMPLETION_URL=https://your-school.sona-systems.com/services/SonaAPI.svc/WebstudyCredit?...&survey_code={survey_code}
SONA_PART_4_COMPLETION_URL=https://your-school.sona-systems.com/services/SonaAPI.svc/WebstudyCredit?...&survey_code={survey_code}

# Local automated tests may bypass SONA. Never enable this on the production VM.
SONA_CREDIT_TEST_MODE=false

# Optional: trained Mastermind RL artifact inside the haic-api container.
# Put the file in services/haic_api/models/ before building and point to it here.
# If unset or invalid, the API uses the bundled dummy consistency-filter model.
# RL_MODEL_PATH=/app/models/mastermind_rl_model.pt
