{
  "$schema": "https://raw.githubusercontent.com/revisit-studies/study/v2.2.0/src/parser/StudyConfigSchema.json",
  "studyMetadata": {
    "title": "Longitudinal Mastermind Study - Part 4",
    "version": "v-6-sona-part-4",
    "authors": [
      "Nils Ness"
    ],
    "date": "2026-09-29",
    "description": "Part 4 of the four-part SONA Mastermind study.",
    "organizations": [
      "Technical University of Munich"
    ]
  },
  "uiConfig": {
    "contactEmail": "nils.ness@tum.de",
    "helpTextPath": "HAIC_study/assets/help.md",
    "logoPath": "HAIC_study/assets/logo.svg",
    "withProgressBar": true,
    "autoDownloadStudy": false,
    "withSidebar": true,
    "enumerateQuestions": true,
    "urlParticipantIdParam": "sona_id",
    "studyEndMsg": "Thank you. Part 4 and the full study are complete, and your SONA credit has been granted.",
    "numSequences": 1
  },
  "importedLibraries": [
    "haic-withdrawal"
  ],
  "components": {
    "mastermind-part": {
      "baseComponent": "$haic-withdrawal.components.mastermind",
      "parameters": {
        "partNumber": 4
      }
    },
    "sona-completion-part": {
      "baseComponent": "$haic-withdrawal.components.sona-completion",
      "parameters": {
        "partNumber": 4
      }
    }
  },
  "sequence": {
    "order": "fixed",
    "components": [
      "mastermind-part",
      "$haic-withdrawal.components.cognitive_responsibility",
      "$haic-withdrawal.components.nasa-tlx",
      {
        "id": "willingness-by-condition",
        "order": "dynamic",
        "functionPath": "haic-withdrawal/willingness.ts"
      },
      "$haic-withdrawal.components.Ownership",
      "sona-completion-part"
    ]
  }
}
